{
  "name": "godot-mcp-server",
  "version": "0.1.1",
  "description": "MCP bridge to the Godot editor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tomnwol/mcp-godot.git"
  },
  "engines": {
    "node": ">=20"
  },
  "mcp": {
    "name": "godot-mcp",
    "title": "Godot MCP"
  },
  "type": "module",
  "main": "build/server.js",
  "bin": {
    "godot-mcp-server": "build/server.js"
  },
  "scripts": {
    "build": "tsc && node scripts/postbuild.js",
    "watch": "tsc --watch",
    "start": "node build/server.js",
    "inspector": "npx @modelcontextprotocol/inspector node build/server.js"
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ws": "^8.21.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.2"
  }
}
