{
  "name": "mcp-hello-server",
  "version": "0.1.0",
  "description": "Serveur MCP minimaliste (TypeScript) exposant un outil hello() de test",
  "type": "module",
  "main": "build/server.js",
  "bin": {
    "mcp-hello-server": "build/server.js"
  },
  "scripts": {
    "build": "tsc && chmod +x build/server.js",
    "watch": "tsc --watch",
    "start": "node build/server.js",
    "inspector": "npx @modelcontextprotocol/inspector node build/server.js"
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
